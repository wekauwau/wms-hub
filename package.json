{
  "name": "wms-hub",
  "author": "wekauwau",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel run dev:server dev:web",
    "dev:server": "pnpm --filter @wms-hub/server dev",
    "dev:web": "pnpm --filter @wms-hub/web dev",
    "build": "pnpm --filter @wms-hub/server build && pnpm --filter @wms-hub/web build",
    "server": "pnpm --filter @wms-hub/server",
    "web": "pnpm --filter @wms-hub/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:migrate": "pnpm server run migrate",
    "db:seed": "pnpm server run seed",
    "lint": "pnpm server run lint && pnpm web run lint",
    "lint:fix": "pnpm server run lint:fix && pnpm web run lint:fix",
    "typecheck": "pnpm server run typecheck && pnpm web run typecheck",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,css}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,vue,json,css}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
