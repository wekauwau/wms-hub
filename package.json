{
  "name": "wms-hub",
  "author": "wekauwau",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "server": "pnpm --filter @wms-hub/server",
    "web": "pnpm --filter @wms-hub/web",
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "dev:server": "pnpm server dev",
    "dev:web": "pnpm web dev",
    "build": "pnpm -r build",
    "db:push": "pnpm server run db:push",
    "db:pull": "pnpm server run db:pull",
    "db:migrate": "pnpm server run migrate",
    "db:seed": "pnpm server run seed",
    "lint": "pnpm server run lint && pnpm web run lint",
    "lint:fix": "pnpm server run lint:fix && pnpm web run lint:fix",
    "typecheck": "pnpm server run typecheck && pnpm web run typecheck",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,css}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,vue,json,css}\"",
    "format:sql": "sqlfluff fix --dialect postgres \"packages/**/*.sql\"",
    "format:sql:check": "sqlfluff lint --dialect postgres \"packages/**/*.sql\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/*.{ts,mts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{json,css,md}": [
      "prettier --write"
    ],
    "packages/**/*.sql": [
      "sqlfluff fix --dialect postgres"
    ]
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.66.0"
  }
}
